# Exa API key (free plan, no payment method). Never commit a real key.
EXA_API_KEY=

# Stripe sandbox only (never commit values). Checkout is enabled only when both are set.
# STRIPE_SECRET_KEY must start with sk_test_, rk_test_, or rkcs_test_; live keys are refused.
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET is the whsec_ value printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=
